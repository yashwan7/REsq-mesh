GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=resq-mesh-backend
# Set to true to disable tracing and metrics explicitly.
OTEL_SDK_DISABLED=false

# Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# Explicit opt-in before clinical prompts may be sent to Sarvam.
SARVAM_ALLOW_CLINICAL_DATA=false
